  "cases": [
    {
      "id": "product-site-platform",
      "tests": [
        "workbuddy_identity_is_product_and_site_scoped",
        "workbuddy_native_login_uses_site_platform_and_private_cookie_lifecycle",
        "codebuddy_workbuddy_imports_require_product_and_site_and_drop_untrusted_fields"
      ]
    },
    {
      "id": "refresh-identity-and-rotation",
