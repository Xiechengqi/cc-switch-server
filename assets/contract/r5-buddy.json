        "refresh_sends_complete_identity_and_journals_rotated_token_before_validation",
        "refresh_accepts_same_site_brand_domain_rotation",
        "refresh_rejects_cross_site_domain_rotation",
        "only_session_dead_invalid_grant_marks_refresh_as_relogin"
      ]
    },
    {
      "id": "catalog-scope",
      "tests": [
        "buddy_catalog_uses_only_the_active_channel_for_each_product_and_site",
        "codebuddy_catalog_refetches_for_same_generation_credential_and_profile_changes",
        "cache_fences_site_and_both_generations_and_bounds_stale"
      ]
    },
    {
      "id": "reasoning-policy",
      "tests": [
        "buddy_default_resolution_preserves_max_and_xhigh_and_never_uses_menu_order",
        "buddy_catalog_rejects_invalid_and_contradictory_defaults",
        "buddy_auto_preserves_tools_and_uses_catalog_reasoning_defaults"
      ]
    },
    {
      "id": "native-tools",
      "tests": [
        "payload_closes_namespace_tool_rounds_across_claude_chat_and_responses",
        "buddy_split_parallel_calls_preserve_results_in_both_orders",
        "buddy_split_calls_never_merge_reasoning_text_or_duplicate_ids"
      ]
    },
    {
      "id": "images",
      "tests": [
        "buddy_fixed_text_models_reject_images_without_silent_substitution_or_refresh",
        "buddy_tool_result_images_survive_native_round_trips",
        "buddy_image_capabilities_are_strict_and_scoped_to_reviewed_cli_models"
      ]
    },
    {
      "id": "strict-terminal",
      "tests": [
        "decoder_requires_one_done_and_rejects_post_terminal_data",
        "valid_tool_is_not_released_after_truncated_or_duplicate_terminal",
        "codebuddy_core03_headers_and_committed_cancel_or_truncation_keep_last_owner_and_no_replay"
      ]
    },
    {
      "id": "quota-and-auth-errors",
      "tests": [
        "codebuddy_workbuddy_modern_billing_empty_fallback_and_transient_classification",
        "modern_billing_auth_failure_is_not_hidden_by_a_successful_sibling",
        "buddy_usage_projection_is_product_site_scoped_and_never_copies_private_details"
      ]
    },
    {
      "id": "official-usage-completeness",
      "tests": [
        "codebuddy_official_usage_sweeps_past_truncated_total_and_deduplicates_boundary",
        "official_usage_deduplicates_and_never_projects_prompt_fields"
      ]
    },
    {
      "id": "cancel-budget-and-recovery",
      "tests": [
        "codebuddy_both_sites_keep_one_request_budget_across_401_recovery",
        "codebuddy_memory_exhaustion_never_replays_or_refreshes_on_either_site",
        "codebuddy_core03_both_sites_original_401_recovery_has_independent_attempts"
      ]
    }
