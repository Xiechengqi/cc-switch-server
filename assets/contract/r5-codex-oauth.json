  "scope": {
    "providerType": "codex_oauth",
    "profiles": [
      "claude.openai_oauth",
      "codex.openai_oauth"
    ],
    "compatibilityApps": [
      "claude",
      "codex",
      "gemini"
    ],
    "product": "ChatGPT Codex OAuth",
    "sites": [
      "https://chatgpt.com",
      "https://auth.openai.com"
    ],
    "credentialRail": "one explicitly bound managed Codex OAuth Account and verified workspace",
    "excludedIdentity": [
      "SIWC",
      "borrowed API key",
      "other Account or workspace"
    ]
  },
  "localPolicy": {
    "interrupt": "only exact current physical connection and response ID; stale/duplicate/unsolicited controls never acquire a new socket, replay, change generation or extend the ACK deadline",
    "ack": {
      "timeoutMs": 30000,
      "terminalIsAck": false,
      "controlFailureIsGenerationFailure": false,
      "newCreateWhileAwaitingAck": false,
      "oldConnectionAckCanAcknowledgeNewTurn": false,
      "nativeAckFields": "preserved after reviewed control-envelope validation"
    },
    "httpFallback": "a matching interrupt returns local interrupt_not_supported and leaves HTTP generation active; no fake accepted/incomplete or discard guarantee",
    "continuation": "exact credential/session/caller/share/Provider/Account/model/endpoint scope and matching tool-call kind; orphan output does not manufacture call history",
    "postCommit": "no generic HTTP/WS fallback or replay after create/business output, ambiguous write loss, or client cancellation",
    "refreshPartial": "after a partial token response outcome_unknown and immediate_relogin fence credentials; never reuse refresh token at another endpoint",
    "restart": "post-validation encrypted journal preserves the same Account/provider/auth generation and rotated token bytes; stale identity cannot activate it; synthetic journal recovery is not JWT/vendor acceptance",
    "identity": "retain existing JWKS/verified subject and selected workspace; SIWC is separately evaluated and not enabled by reference presence",
    "phaseAndReasoning": "retain existing native Responses phase and authenticated encrypted replay; do not invent a private commentary signature",
    "productionWireChanged": false,
    "performanceClaim": false
  },
  "cases": [
    {
      "id": "stale-interrupt",
      "tests": [
        "codex_websocket_late_interrupt_does_not_reach_a_retained_socket",
        "codex_terminal_interrupt_ids_are_bounded_and_connection_local"
      ]
    },
    {
      "id": "wrong-id-duplicate-and-late-ack",
      "tests": [
        "codex_r4_interrupt_ack_order_timeout_and_duplicate_requests_are_connection_local",
        "codex_r4_failed_interrupt_preserves_generation_and_single_usage",
        "codex_r4_http_fallback_interrupt_is_explicitly_unsupported_and_keeps_stream"
      ]
    },
    {
      "id": "old-physical-connection-ack",
      "tests": [
        "codex_r4_interrupt_state_fences_identity_duplicates_ack_and_terminal"
      ]
    },
    {
      "id": "orphan-tool-output",
      "tests": [
        "previous_response_409_requires_an_unpaired_tool_output",
        "previous_response_tool_outputs_require_matching_call_kind",
        "websocket_previous_response_rejects_mismatched_tool_kind_without_history"
      ]
    },
    {
      "id": "committed-ws-disconnect",
      "tests": [
        "codex_websocket_size_close_after_commit_does_not_replay",
        "codex_websocket_first_byte_timeout_after_commit_does_not_replay",
        "codex_websocket_does_not_fallback_after_business_event_is_emitted"
      ]
    },
    {
      "id": "committed-http-disconnect",
      "tests": [
        "codex_http_fallback_eof_after_business_does_not_switch_provider"
      ]
    },
    {
      "id": "codex-partial-refresh",
      "tests": [
        "refresh_response_body_failure_does_not_try_fallback_endpoint"
      ],
      "providerTypes": [
        "claude_oauth",
        "codex_oauth"
      ],
      "sample": "HTTP 200 with a partial rotated token JSON followed by invalid chunk framing",
      "expected": [
        "outcome_unknown",
        "immediate_relogin",
        "no endpoint fallback"
      ]
    },
    {
      "id": "codex-restart-journal",
      "tests": [
        "native_refresh_journal_recovers_rotated_credentials_after_restart_boundary"
      ],
      "providerTypes": [
        "gemini_cli",
        "codex_oauth"
      ],
      "boundary": "synthetic post-validation encrypted commit journal; no JWKS/vendor acceptance claim",
      "restartCases": [
        "matching_generation_recovers",
        "reauthorized_credentials_fence_old_journal"
      ]
    },
    {
      "id": "same-account-auth-recovery",
      "tests": [
        "codex_non_stream_401_forces_one_signed_refresh_and_replays_same_provider",
        "codex_websocket_http_fallback_401_refreshes_once_before_replay"
      ]
    },
    {
      "id": "continuation-credential-fence",
      "tests": [
        "codex_previous_response_scope_rejects_same_generation_credential_change"
      ]
    }
  ]
