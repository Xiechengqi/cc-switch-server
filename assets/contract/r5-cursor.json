      "status": 501,
      "guessExecutableCallFromText": false
    },
    "constraints": {
      "maxTokens": "prompt_best_effort",
      "stop": "prompt_best_effort",
      "json": "prompt_best_effort",
      "hostedTools": "explicitly_unsupported",
      "background": "explicitly_unsupported"
    },
    "replay": "no generic transport/5xx replay without same-rail idempotency evidence",
    "owner": "running/parked h2 and reservations stay with actual last owner; TTL/capacity/cancel close both h2 halves",
    "fencing": "App/Provider/runtime/credential generation/rail/principal/credential digest/machine; late results cannot borrow another identity",
