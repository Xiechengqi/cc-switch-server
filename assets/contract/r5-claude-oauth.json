  "localPolicy": {
    "effort": "preserve caller-owned leading and mid-conversation effort directives; hoist only leading system text",
    "reasoning": "native whitespace-only thinking and its caller signature are not trimmed or turned into visible text",
    "cache": "Messages shape-gates eviction and diagnostics; CountTokens keeps its independent beta contract; native uses audited client betas",
    "tools": "deterministic account/session scoped aliases rewrite protocol name slots only; business input and tool result remain opaque",
    "refusal": "native refusal is retained; bridges preserve content_filter/SAFETY or incomplete status without replay or model substitution",
    "terminal": "native message_delta stop_reason plus message_stop can finish before EOF; message_stop alone is not success; cancel releases the actual upstream owner",
    "drain": {
      "adopted": false,
      "referenceByteLimit": 65536,
      "referenceUniversalTimeOrCancellationBound": false,
      "reason": "detached context without parent deadline can outlive cancellation; retain immediate upstream owner release"
    },
    "refresh": "retain existing durable receipt/journal and same-account uncertainty fencing; no extra retry or credential rail fallback",
    "rateLimit": "retain fail-closed structured scope classification; unqualified text is not a new account permission",
    "performanceClaim": false,
    "tlsFingerprintChange": false
  },
