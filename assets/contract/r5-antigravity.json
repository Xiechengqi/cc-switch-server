  "cases": [
    {
      "id": "late_grounding_native_usage",
      "routes": "both rails x both Apps x stream/nonstream",
      "test": "antigravity_r5_both_rails_and_apps_preserve_late_grounding_and_official_cache_usage",
      "expected": {
        "inputRaw": 7,
        "inputUncached": 5,
        "cacheRead": 2,
        "outputIncludingThought": 4,
        "totalNative": 11
      }
    },
    {
      "id": "missing_terminal",
      "test": "antigravity_r5_both_rails_and_apps_reject_eof_or_done_without_gemini_terminal",
      "expected": "failed, one upstream request, no replay"
    },
    {
      "id": "late_refresh_generation",
      "test": "antigravity_r5_refresh_generation_change_prevents_late_signed_replay_publication",
      "expected": "no old-generation signed cache publication",
      "control": "unchanged generation must publish signed replay on both rails and both Apps"
    },
    {
      "id": "no_textual_auto_heal",
      "test": "antigravity_r5_textual_model_or_signature_error_does_not_rewrite_or_replay",
      "expected": "exact prompt/model, one send, no paid credits"
    },
    {
      "id": "signed_parallel_tool_loop",
      "test": "antigravity_r4_two_turn_final_wire_preserves_preceding_signature",
      "expected": "both rails and both Apps retain exact matching signatures and tool choice NONE"
    },
    {
      "id": "catalog_empty_stale_generation",
      "test": "antigravity_r4_catalog_snapshot_stale_and_empty_are_exactly_scoped",
      "expected": "no cross-rail/token/client inheritance"
    },
    {
      "id": "client_generation_publication",
      "test": "antigravity_r4_publication_fences_client_changes_and_persisted_observations",
      "expected": "A-B-A never resurrects old generation"
    },
    {
      "id": "bounded_replay_owners",
      "test": "antigravity_r4_review_request_copy_is_admitted_and_outlives_cache_entry",
      "expected": "last accounted request owner controls release"
    },
    {
      "id": "cancel_after_commit",
      "test": "antigravity_core03_committed_cancellation_and_error_do_not_replay",
      "expected": "owner released, no replay"
    },
    {
      "id": "pool_opt_in",
      "test": "defaults_to_short_connections_and_bounds_pool_settings",
      "expected": {
        "enabled": false,
        "idleTimeoutMs": 30000,
        "maxIdlePerHost": 2
      }
    }
