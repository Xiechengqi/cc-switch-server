    "identityVersion": "captured antigravity/hub version + UA + opaque generation; fallback 2.2.1, environment override retained",
    "fencing": [
      "Provider revision/fingerprint",
      "Account incarnation",
      "auth/token refresh generation",
      "Bearer fingerprint",
      "project and endpoint",
      "client identity generation",
      "caller/share/session/model for replay"
    ]
  },
  "localPolicy": {
    "pipeline": "keep existing provider facade and shared protocol bridges; no speculative rewrite",
    "grounding": "late citations precede terminal; preserve scalar offsets and native Gemini metadata",
    "usage": "native prompt/cache/candidates/thought/total counts remain authoritative; never replace with estimates",
    "terminal": "Gemini terminal candidate or blocked prompt is required; bare EOF and DONE do not manufacture success; committed cancellation never replays",
    "refresh": "late old token/client generation cannot publish signature replay or model/capability observations",
    "catalog": "authoritative empty catalog revokes; stale only same full identity on transient failure; 24h and 128 entries retained",
    "replay": "strict caller/share/session/provider/account/model/endpoint scope; exact signed call IDs, names, arguments, history and terminal; existing owner budgets retained",
    "paidCredits": "disabled unless separately explicitly selected with official acceptance evidence; unknown balance never auto-enables billing or retry",
    "transport": {
      "poolEnabledByDefault": false,
      "idleTimeoutMs": 30000,
      "maxIdlePerHost": 2,
      "performanceClaim": false
    },
    "rejected": [
      "prompt sanitization",
      "broad model/signature substring auto-heal",
      "continued generation and output stitching",
      "cross-account/rail fallback",
      "unknown balance optimistic paid credits",
      "EOF synthetic success"
    ],
    "resources": "existing per-request and process resident owners, bounds and optional-retention refusal are retained; no new resident inference cache"
  },
