  "localPolicy": {
    "implementationCommit": null,
    "timing": "one immutable request provider/surface, separate attempts, admission/send/headers/first_semantic/body_handoff/terminal/last_owner; bounded static labels only",
    "httpHandoffIsSocketWrite": false,
    "controlsAreContent": false,
    "memoryTrackingWithoutBudget": "lifetime token only; no new request admission for previously unbudgeted drivers",
    "buffers": "web first_semantic observed after complete strict upstream parse; no low-latency claim",
    "deepseekHeaders": "completion send/header callback excludes session creation, PoW and generation preparation",
    "deepseekSession": "shared immutable payload; 256 sessions with 30min TTL; separate 64 active flights; process parent retained through last accepted snapshot",
    "traeCatalog": "shared immutable catalog, original 8min fresh/24h stale rules; 128 entries/32MiB retention, 64 active flights; optional oversized retention may serve one charged live result without publication",
    "webScope": "reserve bounded session/auth slot before send; capacity is 503 before network; no TTL/capacity eviction of authentication invalidation; explicit scope generation/config deletion releases",
    "capacityIsAccountInvalidation": false,
    "ownerReview": {
      "oldEightProviderBudgets": "preserved, not rebuilt",
      "kimiCopilot": "R5 existing parent and flight ownership preserved",
      "geminiQuota": "persisted Account projection, no separate resident runtime catalog",
      "antigravityPublicCatalog": "short-lived copied API/state projection, not a retained shared runtime owner; existing charged internal cache unchanged",
      "webTasks": "no production task insertion; no new job or continuation support"
    },
    "policyUnchanged": [
      "no cross Account/Provider/product/site/credential rail fallback",
      "same existing recovery eligibility/count, deadlines, cooldown and usage",
      "no EOF-success synthesis or credential reimport bypass"
    ],
