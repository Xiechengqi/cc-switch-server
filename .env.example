# cc-switch-server real acceptance environment.
# Copy to a private path such as /tmp/cc-switch-server-real.env before filling values.
# Do not commit real tokens, account emails, raw OAuth responses, or provider secrets.

# Local server under test.
SERVER_URL=http://127.0.0.1:15721
CC_SWITCH_SERVER_TOKEN=<server-login-bearer-token>

# Local ingress body ceilings and the per-request resident-memory budget used by
# Codex, Antigravity, and the exact Claude OAuth, Cursor OAuth/API-key, Grok
# OAuth, Kiro OAuth, Amazon Q OAuth, and Qoder COSY Provider types. It covers raw/decoded/normalized bodies and semantic buffers;
# Codex also accounts normalized events and WebSocket queues, Antigravity
# accounts reasoning replay and grounding/citation state, Claude OAuth accounts
# compressed SSE plus retained stream state, and Cursor accounts protobuf/gzip,
# image, response-aggregation, retry, and parked-session retained state. Grok
# additionally accounts reasoning replay, SSE/WS retained state, multipart/base64
# media expansion, response decoding, and image-stream buffers. Kiro/Amazon Q
# additionally account canonical/wire copies, image decode/resize expansion,
# EventStream frame/decoder state, tool JSON, and downstream stream transforms.
# Qoder additionally accounts canonical/runtime/catalog/payload copies, COSY
# encoding/signing expansion, SSE decoder/aggregator, and downstream transforms.
CC_SWITCH_REQUEST_BODY_LIMIT_MB=64
CC_SWITCH_MEDIA_REQUEST_BODY_LIMIT_MB=256
CC_SWITCH_IMAGE_REQUEST_BODY_LIMIT_MB=256
CC_SWITCH_REQUEST_MEMORY_BUDGET_MB=256

# Router public endpoints.
ROUTER_BASE_URL=https://jptokenswitch.cc
CC_SWITCH_SHARE_URL=https://<share-subdomain>.jptokenswitch.cc
SHARE_ID=<local-server-share-id>

# Router user API token used by authenticated Router Share URL probes.
# Minimum target permission is share invocation; do not use a router admin token.
ROUTER_API_TOKEN=<router-user-api-token>
ROUTER_API_TOKEN_HEADER=Authorization

# Probe behavior.
PROBE_MODEL=probe
STREAM_PROBE=0
REQUIRE_STREAM_USAGE=0
RUN_REAL=0
RUN_CONTRACT_TESTS=1
RUN_TESTS=0
RUN_DEPLOYMENT_TESTS=0
RUN_PROBES=0
EVIDENCE_FILE=/tmp/cc-switch-server-evidence/real-acceptance.json
MATRIX_PATH=docs/provider/regression-matrix.json
MATRIX_SUMMARY_FILE=
MATRIX_LIVE_EVIDENCE_FILE=

# Low-cost real provider regression inputs. Use short prompts only.
CLAUDE_PROVIDER_TOKEN=<redacted-claude-token-or-account-id>
CODEX_PROVIDER_TOKEN=<redacted-codex-token-or-account-id>
GEMINI_PROVIDER_TOKEN=<redacted-gemini-token-or-account-id>

# OAuth migration validation placeholders. These must be real test accounts before AB5-AB7 can pass.
CODEX_OAUTH_TEST_ACCOUNT=<redacted-chatgpt-plus-or-pro-account>
CODEX_OAUTH_CALLBACK_URL=https://<callback-host>/api/accounts/oauth/callback/codex
CODEX_OAUTH_REFRESH_TOKEN=
CODEX_OAUTH_REFRESH_TOKEN_FIXTURE=
CODEX_OAUTH_INVALID_REFRESH_TOKEN=
CODEX_OAUTH_EXPIRED_ACCESS_TOKEN=
CC_SWITCH_CODEX_CLIENT_VERSION=0.144.1
CC_SWITCH_CODEX_USER_AGENT=
# Opt-in recovery for context_length_exceeded; summary calls consume account tokens.
CC_SWITCH_CODEX_OVERFLOW_AUTO_COMPACT=0
# Ordinary Codex Responses SSE downstream keepalive. 0 disables; non-zero values
# are clamped to 5000..60000 ms. The default is 15000 ms.
CC_SWITCH_CODEX_RESPONSES_KEEPALIVE_MS=15000
# Emergency rollback only. Enabled by default: validates and canonicalizes upstream
# Responses SSE, dropping only allowlisted liveness frames before downstream relay.
CC_SWITCH_CODEX_RESPONSES_SSE_NORMALIZER_ENABLED=1
# Experimental protocol-level HTTP/2 PING for long active outbound streams. Disabled
# by default; when enabled, interval/timeout are clamped to safe bounded ranges.
CC_SWITCH_OUTBOUND_HTTP2_KEEPALIVE_ENABLED=0
CC_SWITCH_OUTBOUND_HTTP2_KEEPALIVE_INTERVAL_MS=45000
CC_SWITCH_OUTBOUND_HTTP2_KEEPALIVE_TIMEOUT_MS=20000
# Experimental server-owned HTTP routing hint. Keep disabled until the real OAuth
# smoke confirms the current account/model accepts it; never applies to WS handshake.
CC_SWITCH_CODEX_ROUTING_HINT_ENABLED=0
# Durable capability files default to <config-dir>/image-capabilities. Point every
# replica at the same mounted directory only when it supports cross-process locks,
# same-filesystem atomic rename/directory sync, and compatible Unix permissions.
CC_SWITCH_IMAGE_STORE_DIR=
# Explicitly opt into the billable 4K Images/Responses Cloudflare smoke.
CC_SWITCH_CODEX_IMAGES_SMOKE=0
# The billable image smoke above is probe-only. Live acceptance is split into
# four operation-scoped private receipts stored outside the repository.
CC_SWITCH_CODEX_REAL_OPERATION=
CODEX_REAL_RECEIPT_FILE=
CODEX_GPT_IMAGE_2_5_REAL_RECEIPT_FILE=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_PROVIDER_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_SHARE_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_MODEL=gpt-image-2.5
CODEX_GPT_IMAGE_2_5_FLARE_REAL_RECEIPT_FILE=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_FLARE_PROVIDER_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_FLARE_SHARE_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_FLARE_MODEL=gpt-image-2.5-flare
CODEX_GPT_IMAGE_2_5_SUNBURST_REAL_RECEIPT_FILE=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_SUNBURST_PROVIDER_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_SUNBURST_SHARE_ID=
CC_SWITCH_CODEX_GPT_IMAGE_2_5_SUNBURST_MODEL=gpt-image-2.5-sunburst
CODEX_WS_PREWARM_REAL_RECEIPT_FILE=
CC_SWITCH_CODEX_WS_PREWARM_PROVIDER_ID=
CC_SWITCH_CODEX_WS_PREWARM_SHARE_ID=
CC_SWITCH_CODEX_WS_PREWARM_MODEL=gpt-5.4-mini
CLAUDE_OAUTH_TEST_ACCOUNT=<redacted-claude-account>
CLAUDE_OAUTH_MAX_5X_TEST_ACCOUNT=<redacted-claude-max-5x-account>
CLAUDE_OAUTH_MAX_20X_TEST_ACCOUNT=<redacted-claude-max-20x-account>
CLAUDE_OAUTH_CALLBACK_URL=https://<callback-host>/api/accounts/oauth/callback/claude
CLAUDE_OAUTH_REFRESH_TOKEN=
CLAUDE_OAUTH_REFRESH_TOKEN_FIXTURE=
# Claude live acceptance is operation-scoped. Keep every private receipt outside
# the repository and run scripts/smoke/claude-real-receipt.mjs once per operation.
CC_SWITCH_CLAUDE_REAL_OPERATION=
CLAUDE_REAL_RECEIPT_FILE=
CLAUDE_OAUTH_INFERENCE_REAL_RECEIPT_FILE=
CC_SWITCH_CLAUDE_OAUTH_PROVIDER_ID=
CC_SWITCH_CLAUDE_OAUTH_SHARE_ID=
CC_SWITCH_CLAUDE_OAUTH_MODEL=claude-sonnet-4-6
CLAUDE_MAX_5X_REAL_RECEIPT_FILE=
CC_SWITCH_CLAUDE_MAX_5X_PROVIDER_ID=
CC_SWITCH_CLAUDE_MAX_5X_SHARE_ID=
CC_SWITCH_CLAUDE_MAX_5X_MODEL=claude-sonnet-4-6
CLAUDE_MAX_20X_REAL_RECEIPT_FILE=
CC_SWITCH_CLAUDE_MAX_20X_PROVIDER_ID=
CC_SWITCH_CLAUDE_MAX_20X_SHARE_ID=
CC_SWITCH_CLAUDE_MAX_20X_MODEL=claude-sonnet-4-6
CLAUDE_FABLE_5_1_REAL_RECEIPT_FILE=
CC_SWITCH_CLAUDE_FABLE_5_1_PROVIDER_ID=
CC_SWITCH_CLAUDE_FABLE_5_1_SHARE_ID=
CC_SWITCH_CLAUDE_FABLE_5_1_MODEL=claude-fable-5-1
# Audited Claude Code wire profile identity. Leave both overrides blank normally.
# A valid CC_SWITCH_CLI_UA takes precedence over the version-only override; both
# are emergency compatibility controls. Invalid or older candidates are ignored;
# when no valid override remains, identity fails closed to the built-in profile.
CC_SWITCH_CLI_UA_VERSION=
CC_SWITCH_CLI_UA=
GEMINI_OAUTH_TEST_ACCOUNT=<redacted-google-account>
GEMINI_OAUTH_CALLBACK_URL=https://<callback-host>/api/accounts/oauth/callback/gemini
GEMINI_OAUTH_REFRESH_TOKEN=
GEMINI_OAUTH_REFRESH_TOKEN_FIXTURE=
GEMINI_CLI_CREDENTIALS_FIXTURE=
# Optional input for the ignored Ollama Cloud account/usage live smoke. This is
# test-only and is never loaded as Server runtime Provider configuration.
OLLAMA_API_KEY=

# Optional read-only roots for Web Session external evidence drift checks.
# Defaults resolve to ../proxy/{OmniRoute,9router} from this repository.
CC_SWITCH_WEB_SESSION_OMNIROUTE_AUDIT_ROOT=
CC_SWITCH_WEB_SESSION_9ROUTER_AUDIT_ROOT=
CURSOR_OAUTH_TEST_ACCOUNT=<redacted-cursor-account>
CURSOR_OAUTH_CALLBACK_URL=https://<callback-host>/api/accounts/oauth/callback/cursor
CURSOR_OAUTH_REFRESH_TOKEN_FIXTURE=
CURSOR_API_KEY_FIXTURE=
# Cursor OAuth and API-key receipts are independent and remain live_pending
# until their own target-commit-bound private receipt passes. Keep receipt files
# outside the repository with mode 0600. The generic file is a CLI fallback.
CC_SWITCH_CURSOR_REAL_RAIL=
CURSOR_REAL_PROVIDER_APP=codex
CURSOR_REAL_FAST_MODEL=
CURSOR_REAL_RECEIPT_FILE=
CURSOR_OAUTH_REAL_RECEIPT_FILE=
CC_SWITCH_CURSOR_OAUTH_PROVIDER_ID=
CC_SWITCH_CURSOR_OAUTH_SHARE_ID=
CC_SWITCH_CURSOR_OAUTH_MODEL=composer-2.5-fast
CURSOR_API_KEY_REAL_RECEIPT_FILE=
CC_SWITCH_CURSOR_API_KEY_PROVIDER_ID=
CC_SWITCH_CURSOR_API_KEY_SHARE_ID=
CC_SWITCH_CURSOR_API_KEY_MODEL=composer-2.5-fast
# Cursor inference is split into credential-bound rails. By default, both rails use
# the official ServerConfig service to discover their assigned AgentService origin,
# and API-key exchange uses Cursor's official exchange endpoint. The values below are
# optional complete-HTTPS endpoint overrides; keep any private override out of logs.
CC_SWITCH_CURSOR_SERVER_CONFIG_ENDPOINT=
CC_SWITCH_CURSOR_OAUTH_AGENT_ENDPOINT=
CC_SWITCH_CURSOR_APIKEY_AGENT_ENDPOINT=
CC_SWITCH_CURSOR_APIKEY_EXCHANGE_ENDPOINT=
# Independent deployment kill switches. A disabled rail never falls back to the other.
CC_SWITCH_CURSOR_OAUTH_AGENT_ENABLED=1
CC_SWITCH_CURSOR_APIKEY_AGENT_ENABLED=1
# Optional audited client-version overrides; blank uses local detection/defaults.
CC_SWITCH_CURSOR_AGENT_CLI_VERSION=
CC_SWITCH_CURSOR_SDK_CLIENT_VERSION=
ANTIGRAVITY_OAUTH_TEST_ACCOUNT=<redacted-google-account>
ANTIGRAVITY_OAUTH_CALLBACK_URL=https://<callback-host>/api/accounts/oauth/callback/antigravity
ANTIGRAVITY_OAUTH_REFRESH_TOKEN_FIXTURE=
# Antigravity and Agy live receipts are intentionally independent. Invoke
# scripts/smoke/antigravity-real.mjs once per rail and keep each private receipt
# outside the repository. The generic receipt variable is a one-run CLI fallback.
CC_SWITCH_ANTIGRAVITY_REAL_RAIL=
ANTIGRAVITY_REAL_RECEIPT_FILE=
ANTIGRAVITY_OAUTH_REAL_RECEIPT_FILE=
CC_SWITCH_ANTIGRAVITY_OAUTH_SHARE_ID=
CC_SWITCH_ANTIGRAVITY_OAUTH_CLAUDE_PROVIDER_ID=
CC_SWITCH_ANTIGRAVITY_OAUTH_GEMINI_PROVIDER_ID=
CC_SWITCH_ANTIGRAVITY_OAUTH_CLAUDE_MODEL=claude-sonnet-4-6
CC_SWITCH_ANTIGRAVITY_OAUTH_GEMINI_MODEL=gemini-3.5-flash-medium
AGY_OAUTH_TEST_ACCOUNT=<redacted-agy-google-account>
AGY_OAUTH_REAL_RECEIPT_FILE=
CC_SWITCH_AGY_OAUTH_SHARE_ID=
CC_SWITCH_AGY_OAUTH_CLAUDE_PROVIDER_ID=
CC_SWITCH_AGY_OAUTH_GEMINI_PROVIDER_ID=
CC_SWITCH_AGY_OAUTH_CLAUDE_MODEL=claude-sonnet-4-6
CC_SWITCH_AGY_OAUTH_GEMINI_MODEL=gemini-3.5-flash-medium

# Grok OAuth single-account acceptance. The Share-bound Provider must use exactly one
# grok_oauth account; the smoke script never selects or rotates across accounts.
GROK_OAUTH_TEST_ACCOUNT=<redacted-xai-account>
GROK_OAUTH_CALLBACK_URL=http://127.0.0.1:56121/callback
GROK_OAUTH_REFRESH_TOKEN_FIXTURE=
GROK_OAUTH_AUTH_JSON_FIXTURE=
# Normal-path smoke only; it always reports probe_only/live_pending and cannot
# satisfy any operation receipt below.
CC_SWITCH_GROK_MODEL=grok-4.6
CC_SWITCH_GROK_MEDIA_SMOKE=0
# Grok inference, media, and remote-compaction receipts are independent. Keep
# every private receipt outside the repository with mode 0600. A compaction
# receipt records upstream evidence only and never auto-enables runtime support.
CC_SWITCH_GROK_REAL_OPERATION=
GROK_REAL_RECEIPT_FILE=
CC_SWITCH_GROK_SIGNED_USER=
CC_SWITCH_GROK_SESSION_ID=
CC_SWITCH_GROK_TURN_INDEX=
GROK_INFERENCE_REAL_RECEIPT_FILE=
CC_SWITCH_GROK_INFERENCE_PROVIDER_ID=
CC_SWITCH_GROK_INFERENCE_SHARE_ID=
CC_SWITCH_GROK_INFERENCE_MODEL=grok-4.6
GROK_MEDIA_REAL_RECEIPT_FILE=
CC_SWITCH_GROK_MEDIA_PROVIDER_ID=
CC_SWITCH_GROK_MEDIA_SHARE_ID=
CC_SWITCH_GROK_MEDIA_MODEL=grok-4.6
GROK_REMOTE_COMPACTION_REAL_RECEIPT_FILE=
CC_SWITCH_GROK_COMPACTION_PROVIDER_ID=
CC_SWITCH_GROK_COMPACTION_SHARE_ID=
CC_SWITCH_GROK_COMPACTION_MODEL=grok-4.6

# Grok protocol identity and capability gates. Production OAuth/OIDC endpoints are fixed.
CC_SWITCH_SERVER_XAI_CLIENT_ID=
CC_SWITCH_GROK_CLI_VERSION=0.2.111
CC_SWITCH_GROK_CLI_USER_AGENT=
# Clamped to 1-86400 seconds.
CC_SWITCH_GROK_MODELS_TTL_SECONDS=300
CC_SWITCH_GROK_OAUTH_CAPABILITIES=

# Server-native OAuth request-shape fixtures. Keep secrets in private env only.
CC_SWITCH_SERVER_GEMINI_CLIENT_ID=
CC_SWITCH_SERVER_GEMINI_CLIENT_SECRET=
CC_SWITCH_SERVER_CURSOR_CLIENT_ID=
CC_SWITCH_SERVER_ANTIGRAVITY_CLIENT_ID=
CC_SWITCH_SERVER_ANTIGRAVITY_CLIENT_SECRET=

# Optional canonical IPv4 override for Qoder CN COSY signing when the HTTP
# proxy owns DNS/routing and the Server cannot infer the intended interface.
CC_SWITCH_QODER_CN_CLIENT_IP=

# Long-tail provider real validation placeholders. These are gates only; filling them does not
# mean the provider can be marked native before non-stream/stream/usage evidence is captured.
# Qoder runs one credential rail per invocation. Each rail needs three explicit
# Surface Providers bound to the same Account generation. Keep receipts outside
# the repository and set QODER_REAL_RECEIPT_FILE to a new absolute path per run.
CC_SWITCH_QODER_REAL_RAIL=
QODER_REAL_RECEIPT_FILE=
QODER_GLOBAL_OAUTH_TEST_ACCOUNT=<redacted-qoder-global-oauth-account>
CC_SWITCH_QODER_GLOBAL_OAUTH_CLAUDE_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_OAUTH_CODEX_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_OAUTH_GEMINI_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_OAUTH_SHARE_ID=
CC_SWITCH_QODER_GLOBAL_OAUTH_MODEL=
QODER_GLOBAL_PAT_TEST_ACCOUNT=<redacted-qoder-global-pat-account>
CC_SWITCH_QODER_GLOBAL_PAT_CLAUDE_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_PAT_CODEX_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_PAT_GEMINI_PROVIDER_ID=
CC_SWITCH_QODER_GLOBAL_PAT_SHARE_ID=
CC_SWITCH_QODER_GLOBAL_PAT_MODEL=
QODER_CN_OAUTH_TEST_ACCOUNT=<redacted-qoder-cn-oauth-account>
CC_SWITCH_QODER_CN_OAUTH_CLAUDE_PROVIDER_ID=
CC_SWITCH_QODER_CN_OAUTH_CODEX_PROVIDER_ID=
CC_SWITCH_QODER_CN_OAUTH_GEMINI_PROVIDER_ID=
CC_SWITCH_QODER_CN_OAUTH_SHARE_ID=
CC_SWITCH_QODER_CN_OAUTH_MODEL=
# CodeBuddy live acceptance is split by immutable site. Each private receipt
# validates one OAuth Account, one Share, and three explicit Surface Providers.
# Receipt paths must be absolute, outside this repository, and mode 0600.
CC_SWITCH_CODEBUDDY_REAL_SITE=
CODEBUDDY_INTL_TEST_ACCOUNT=<redacted-codebuddy-intl-account>
CC_SWITCH_CODEBUDDY_INTL_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_CODEBUDDY_INTL_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_CODEBUDDY_INTL_GEMINI_PROVIDER_ID=<gemini-provider-id>
CC_SWITCH_CODEBUDDY_INTL_SHARE_ID=<share-id>
CC_SWITCH_CODEBUDDY_INTL_MODEL=<exact-catalog-model>
CODEBUDDY_INTL_REAL_RECEIPT_FILE=/absolute/private/path/codebuddy-intl.json
CODEBUDDY_CN_TEST_ACCOUNT=<redacted-codebuddy-cn-account>
CC_SWITCH_CODEBUDDY_CN_CLAUDE_PROVIDER_ID=<claude-provider-id>
