CC_SWITCH_CODEBUDDY_CN_GEMINI_PROVIDER_ID=<gemini-provider-id>
CC_SWITCH_CODEBUDDY_CN_SHARE_ID=<share-id>
CC_SWITCH_CODEBUDDY_CN_MODEL=<exact-catalog-model>
CODEBUDDY_CN_REAL_RECEIPT_FILE=/absolute/private/path/codebuddy-cn.json
GITHUB_COPILOT_TEST_ACCOUNT=<redacted-github-account>
GITHUB_COPILOT_GITHUB_DOMAIN=github.com
GITHUB_COPILOT_TOKEN_FIXTURE=
# Three explicit Providers must bind the same selected Copilot Account generation.
CC_SWITCH_COPILOT_CLAUDE_PROVIDER_ID=
CC_SWITCH_COPILOT_CODEX_PROVIDER_ID=
CC_SWITCH_COPILOT_GEMINI_PROVIDER_ID=
CC_SWITCH_COPILOT_MODEL=
KIRO_TEST_ACCOUNT=<redacted-builder-id-account>
KIRO_REGION=us-east-1
KIRO_START_URL=https://view.awsapps.com/start
KIRO_REFRESH_TOKEN_FIXTURE=
# Kiro live acceptance is split into eight private receipt scopes. Account
# selectors are IDs or redacted emails, never credentials. Receipt paths must
# be absolute, outside this repository, and mode 0600.
CC_SWITCH_KIRO_SIGNED_USER=<signed-user@example.com>
CC_SWITCH_KIRO_SESSION_ID=<bounded-session-id>
KIRO_BUILDER_ID_US_EAST_1_TEST_ACCOUNT=<redacted-builder-id-us-east-1-account>
CC_SWITCH_KIRO_BUILDER_ID_US_EAST_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_BUILDER_ID_US_EAST_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_BUILDER_ID_US_EAST_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_BUILDER_ID_US_EAST_1_MODEL=<exact-catalog-model>
KIRO_BUILDER_ID_US_EAST_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-builder-id-us-east-1.json
KIRO_BUILDER_ID_EU_CENTRAL_1_TEST_ACCOUNT=<redacted-builder-id-eu-central-1-account>
CC_SWITCH_KIRO_BUILDER_ID_EU_CENTRAL_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_BUILDER_ID_EU_CENTRAL_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_BUILDER_ID_EU_CENTRAL_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_BUILDER_ID_EU_CENTRAL_1_MODEL=<exact-catalog-model>
KIRO_BUILDER_ID_EU_CENTRAL_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-builder-id-eu-central-1.json
KIRO_IDC_US_EAST_1_TEST_ACCOUNT=<redacted-idc-us-east-1-account>
CC_SWITCH_KIRO_IDC_US_EAST_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_IDC_US_EAST_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_IDC_US_EAST_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_IDC_US_EAST_1_MODEL=<exact-catalog-model>
KIRO_IDC_US_EAST_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-idc-us-east-1.json
KIRO_IDC_EU_CENTRAL_1_TEST_ACCOUNT=<redacted-idc-eu-central-1-account>
CC_SWITCH_KIRO_IDC_EU_CENTRAL_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_IDC_EU_CENTRAL_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_IDC_EU_CENTRAL_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_IDC_EU_CENTRAL_1_MODEL=<exact-catalog-model>
KIRO_IDC_EU_CENTRAL_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-idc-eu-central-1.json
KIRO_SOCIAL_US_EAST_1_TEST_ACCOUNT=<redacted-social-us-east-1-account>
CC_SWITCH_KIRO_SOCIAL_US_EAST_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_SOCIAL_US_EAST_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_SOCIAL_US_EAST_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_SOCIAL_US_EAST_1_MODEL=<exact-catalog-model>
KIRO_SOCIAL_US_EAST_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-social-us-east-1.json
KIRO_SOCIAL_EU_CENTRAL_1_TEST_ACCOUNT=<redacted-social-eu-central-1-account>
CC_SWITCH_KIRO_SOCIAL_EU_CENTRAL_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_SOCIAL_EU_CENTRAL_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_SOCIAL_EU_CENTRAL_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_SOCIAL_EU_CENTRAL_1_MODEL=<exact-catalog-model>
KIRO_SOCIAL_EU_CENTRAL_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-social-eu-central-1.json
KIRO_API_KEY_US_EAST_1_TEST_ACCOUNT=<redacted-api-key-us-east-1-account-id>
CC_SWITCH_KIRO_API_KEY_US_EAST_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_API_KEY_US_EAST_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_API_KEY_US_EAST_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_API_KEY_US_EAST_1_MODEL=<exact-catalog-model>
KIRO_API_KEY_US_EAST_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-api-key-us-east-1.json
KIRO_API_KEY_EU_CENTRAL_1_TEST_ACCOUNT=<redacted-api-key-eu-central-1-account-id>
CC_SWITCH_KIRO_API_KEY_EU_CENTRAL_1_CLAUDE_PROVIDER_ID=<claude-provider-id>
CC_SWITCH_KIRO_API_KEY_EU_CENTRAL_1_CODEX_PROVIDER_ID=<codex-provider-id>
CC_SWITCH_KIRO_API_KEY_EU_CENTRAL_1_SHARE_ID=<share-id>
CC_SWITCH_KIRO_API_KEY_EU_CENTRAL_1_MODEL=<exact-catalog-model>
KIRO_API_KEY_EU_CENTRAL_1_REAL_RECEIPT_FILE=/absolute/private/path/kiro-api-key-eu-central-1.json
# Amazon Q Developer is an independent Builder ID/IdC entitlement rail. Do not
# reuse Kiro Account IDs, refresh tokens, Provider IDs, or runtime endpoints.
AMAZON_Q_TEST_ACCOUNT=<redacted-amazon-q-account>
AMAZON_Q_REFRESH_TOKEN_FIXTURE=
CC_SWITCH_AMAZON_Q_CLAUDE_PROVIDER_ID=
CC_SWITCH_AMAZON_Q_CODEX_PROVIDER_ID=
CC_SWITCH_AMAZON_Q_MODEL=
CC_SWITCH_AMAZON_Q_RUNTIME_REGION=us-east-1
CC_SWITCH_AMAZON_Q_PROFILE_ARN=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Local bootstrap helpers.
HOST=127.0.0.1
PORT=
CONFIG_DIR=
KEEP_SERVER=1
KEEP_CONFIG_DIR=0
RUN_SMOKE=1
